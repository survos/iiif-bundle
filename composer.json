{
    "name": "survos/iiif-bundle",
    "description": "PHP 8.4+ Symfony bundle for generating IIIF Presentation API 3.0 manifests",
    "license": "MIT",
    "type": "symfony-bundle",
    "keywords": ["symfony", "symfony-ux", "ux", "iiif", "viewer", "openseadragon", "diva"],
    "require": {
        "php": "^8.5",
        "symfony/framework-bundle": "^8.1",
        "symfony/serializer": "^8.1",
        "survos/kit-bundle": "^2.5",
        "survos/fetch-bundle": "^2.5"
    },
    "suggest": {
        "symfony/ux-twig-component": "Required for the IiifViewer Twig component",
        "symfony/asset-mapper": "Required for the bundled OpenSeadragon Stimulus controller"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0",
        "justinrainbow/json-schema": "^6.0",
        "phpstan/phpstan": "^2.0",
        "phpstan/extension-installer": "^1.4"
    },
    "autoload": {
        "psr-4": {
            "Survos\\IiifBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Survos\\IiifBundle\\Tests\\": "tests/"
        }
    },
    "extra": {
        "symfony": {
            "bundles": {
                "Survos\\IiifBundle\\SurvosIiifBundle": ["all"]
            },
            "keywords": ["symfony-ux"]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    }
}
