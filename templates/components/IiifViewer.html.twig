{#
  IiifViewer component — OpenSeadragon IIIF viewer with optional external viewer links.

  Props (from IiifViewer.php):
    infoUrl         (string)  IIIF Image API info.json URL
    manifestUrl     (string)  Direct link to the raw IIIF manifest JSON — also drives the
                              self-contained "diva.js" compare-link overlay on OSD branches
    infoUrls        (list)    Per-page imgproxy /info URLs — drives the dimensions badge
    summaries       (list)    Per-page caption/credit text, forwarded via iiif-viewer:page's detail.summary
    options         (object)  OpenSeadragon viewer options
    miradorUrl      (string)  App route that redirects to Mirador
    uvUrl           (string)  App route that redirects to Universal Viewer
    meta            (string)  Optional footer metadata string
    height          (int)     Viewer max height in pixels
    showLinks       (bool)    Show external viewer link buttons (IIIF/Manifest/Mirador/UV)
#}

{% set resolvedInfoUrl = infoUrl ?? '' %}
{% set viewerHeight = height|default(420) %}

{% set defaultStyle %}
    background:#111111;
    width:100%;
    position:relative;
    min-height:{{ viewerHeight }}px;
    height:clamp(320px,70vh,{{ viewerHeight }}px);
{% endset %}

{% set divaStyle %}
    background:#f7f5f1;
    width:100%;
    position:relative;
    min-height:{{ viewerHeight }}px;
    height:clamp(320px,70vh,{{ viewerHeight }}px);
{% endset %}

{% set viewerOptions = options|default({}) %}

{# Toolbar icons for the OpenSeadragon (non-diva) branches, rendered server-side via
   ux-icons so the viewer's nav buttons match the app's own icon set instead of OSD's
   stock jsDelivr-hosted PNG sprites — see iiif-viewer_controller.js _buildToolbar(). #}
{% set osdIcons = {
    zoomIn: '' ~ ux_icon('tabler:zoom-in'),
    zoomOut: '' ~ ux_icon('tabler:zoom-out'),
    home: '' ~ ux_icon('tabler:home'),
    fullPage: '' ~ ux_icon('tabler:maximize'),
    previous: '' ~ ux_icon('tabler:chevron-left'),
    next: '' ~ ux_icon('tabler:chevron-right'),
    rotateLeft: '' ~ ux_icon('tabler:rotate'),
    rotateRight: '' ~ ux_icon('tabler:rotate-clockwise'),
    flip: '' ~ ux_icon('tabler:flip-horizontal'),
} %}

<div {{ attributes.defaults({ class: 'iiif-viewer' }) }}>

    <style>
        .iiif-viewer {
            width: 100%;
            max-width: 100%;
        }

        .iiif-viewer .openseadragon-container {
            position: absolute !important;
            inset: 0;
            width: 100% !important;
            height: 100% !important;
        }

        .iiif-viewer .iiif-compare-link {
            position: absolute;
            top: 8px;
            right: 8px;
            z-index: 10;
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 4px 10px;
            border-radius: 12px;
            background: rgba(17, 17, 17, .65);
            color: #fff;
            font-size: 12px;
            text-decoration: none;
        }
        .iiif-viewer .iiif-compare-link:hover {
            background: rgba(17, 17, 17, .9);
            color: #fff;
        }

        @media (max-width: 768px) {
            .iiif-viewer [data-controller] {
                height: 60vh !important;
                min-height: 300px !important;
            }
        }
    </style>

    {# The two OSD branches below both need to compare against diva.js when a manifest is
       available — self-contained here so callers (e.g. folio-bundle's detail page) don't
       need to know the debug route exists or build the link themselves.

       The URL comes from the component (this.divaDebugUrl), NOT from path() here: the
       standalone diva viewer is a debug route that survos_iiif.routes_enabled now leaves
       off by default, and calling path() on a route that isn't registered throws. The
       component returns null in that case and the link is simply omitted. Apps that want
       it back set `survos_iiif: { routes_enabled: true }`. #}
    {% set compareLink %}
        {% if this.divaDebugUrl %}
            <a href="{{ this.divaDebugUrl }}"
               target="_blank" rel="noopener" class="iiif-compare-link">
                {{ ux_icon('tabler:book', { class: 'icon icon-sm' }) }} diva.js
            </a>
        {% endif %}
    {% endset %}

    {% if viewer == 'diva' and manifestUrl %}

        {% set _sc = survos_stimulus('iiif-bundle', 'iiif-diva') %}

        <div
            {{
                stimulus_controller(_sc,
                    viewerOptions is not empty
                        ? { manifestUrl: manifestUrl, options: viewerOptions }
                        : { manifestUrl: manifestUrl }
                )
            }}
            style="{{ divaStyle }}">
        </div>

    {% elseif images|default([]) is not empty %}

        {% set _sc = survos_stimulus('iiif-bundle', 'iiif-viewer') %}
        {% set viewerValues = { images: images, icons: osdIcons } %}

        {% if hiresImages|default([]) is not empty %}
            {% set viewerValues = viewerValues|merge({ hiresImages: hiresImages }) %}
        {% endif %}

        {% if infoUrls|default([]) is not empty %}
            {% set viewerValues = viewerValues|merge({ infoUrls: infoUrls }) %}
        {% endif %}

        {% if summaries|default([]) is not empty %}
            {% set viewerValues = viewerValues|merge({ summaries: summaries }) %}
        {% endif %}

        {% if viewerOptions is not empty %}
            {% set viewerValues = viewerValues|merge({ options: viewerOptions }) %}
        {% endif %}

        <div
            {{ stimulus_controller(_sc, viewerValues) }}
            style="{{ defaultStyle }}">
            {{ compareLink }}
        </div>

    {% elseif resolvedInfoUrl %}

        {% set _sc = survos_stimulus('iiif-bundle', 'iiif-viewer') %}
        {% set viewerValues = { manifestUrl: manifestUrl, tileSourceUrl: resolvedInfoUrl, icons: osdIcons } %}

        {% if viewerOptions is not empty %}
            {% set viewerValues = viewerValues|merge({ options: viewerOptions }) %}
        {% endif %}

        <div
            {{ stimulus_controller(_sc, viewerValues) }}
            style="{{ defaultStyle }}">
            {{ compareLink }}
        </div>

    {% else %}

        <div style="min-height:{{ viewerHeight }}px; display:flex; align-items:center;
                    justify-content:center; background:#111; color:#666; border-radius:4px;">
            <span style="font-size:.85rem;">No image available</span>
        </div>

    {% endif %}

    {% if meta or (showLinks and (manifestUrl or miradorUrl or uvUrl)) %}
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 px-2 py-1 small text-muted border-top">

            <span>{{ meta }}</span>

            {% if showLinks %}
                <div class="d-flex gap-2 flex-wrap">
                    {% if resolvedInfoUrl %}
                        <a href="{{ resolvedInfoUrl }}" target="_blank" class="btn btn-xs btn-ghost-secondary">IIIF ↗</a>
                    {% endif %}

                    {% if manifestUrl %}
                        <a href="{{ manifestUrl }}" target="_blank" class="btn btn-xs btn-ghost-secondary">Manifest ↗</a>
                    {% endif %}

                    {% if miradorUrl %}
                        <a href="{{ miradorUrl }}" target="_blank" class="btn btn-xs btn-ghost-secondary">Mirador ↗</a>
                    {% endif %}

                    {% if uvUrl %}
                        <a href="{{ uvUrl }}" target="_blank" class="btn btn-xs btn-ghost-secondary">Universal Viewer ↗</a>
                    {% endif %}
                </div>
            {% endif %}

        </div>
    {% endif %}

</div>
