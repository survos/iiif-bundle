{#
  IiifViewer component — OpenSeadragon IIIF viewer with optional external viewer links.

  Props (from IiifViewer.php):
    infoUrl         (string)  IIIF Image API info.json URL (required for the embedded viewer)
    manifestUrl     (string)  Direct link to the raw IIIF manifest JSON
    options         (object)  OpenSeadragon viewer options (optional)
    miradorUrl      (string)  App route that redirects to Mirador
    uvUrl           (string)  App route that redirects to Universal Viewer
    meta            (string)  Optional footer metadata string
    height          (int)     Viewer height in pixels (default 420)
    showLinks       (bool)    Show external viewer link buttons

  Stimulus controller ids are resolved via survos_stimulus('iiif-bundle', …) (kit-bundle),
  not props — so they can't drift from what Flex registered.
#}

{% set resolvedInfoUrl = infoUrl ?? '' %}
{% set defaultStyle = 'background: #111111; min-height: ' ~ height ~ 'px; width: 100%;' %}
{# diva renders its own (light) chrome — header, toolbar, sidebar — with dark icons
   and no dark theme, so it needs a LIGHT host surface (the #111 black above hides
   the icons/title). It also needs a definite height and display:flex to fill it. #}
{% set divaStyle = 'background: #f7f5f1; height: ' ~ height ~ 'px; width: 100%; display: flex;' %}

{# An empty Twig hash {} serializes to a JSON array [], which Stimulus rejects for
   an Object-typed value. Only pass `options` when it actually carries settings. #}
{% set viewerOptions = options|default({}) %}

<div {{ attributes.defaults({ class: 'iiif-viewer' }) }}>

    {% if viewer == 'diva' and manifestUrl %}

        {# diva.js page-turning document viewer — needs a IIIF Presentation manifest.
           Controller name comes from survos_stimulus() (kit-bundle), never a hard-coded
           string — it's validated against the installed bundles in dev. #}
        {% set _sc = survos_stimulus('iiif-bundle', 'iiif-diva') %}
        <div
            {{
                stimulus_controller(_sc,
                    viewerOptions is not empty
                        ? { manifestUrl: manifestUrl, options: viewerOptions }
                        : { manifestUrl: manifestUrl }
                )
            }}
            style="{{ divaStyle }}">
        </div>

    {% elseif images|default([]) is not empty %}

        {# OpenSeadragon paging through plain images (no IIIF Image API needed) #}
        <style>
            .openseadragon-container { position: absolute !important; }
        </style>

        {% set _sc = survos_stimulus('iiif-bundle', 'iiif-viewer') %}
        {% set viewerValues = { images: images } %}
        {% if hiresImages|default([]) is not empty %}{% set viewerValues = viewerValues|merge({ hiresImages: hiresImages }) %}{% endif %}
        {% if viewerOptions is not empty %}{% set viewerValues = viewerValues|merge({ options: viewerOptions }) %}{% endif %}
        <div
            {{ stimulus_controller(_sc, viewerValues) }}
            style="{{ defaultStyle }}">
        </div>

    {% elseif resolvedInfoUrl %}

        <style>
            .openseadragon-container {
                position: absolute !important;
            }
        </style>

        {% set _sc = survos_stimulus('iiif-bundle', 'iiif-viewer') %}
        <div
            {{
                stimulus_controller(_sc,
                    viewerOptions is not empty
                        ? { manifestUrl: manifestUrl, tileSourceUrl: resolvedInfoUrl, options: viewerOptions }
                        : { manifestUrl: manifestUrl, tileSourceUrl: resolvedInfoUrl }
                )
            }}
            style="{{ defaultStyle }}">
        </div>

    {% else %}

        {# No info URL — caller is responsible for providing a fallback #}
        <div style="min-height:{{ height }}px; display:flex; align-items:center;
                    justify-content:center; background:#111; color:#666; border-radius:4px;">
            <span style="font-size:.85rem;">No image available</span>
        </div>

    {% endif %}

    {% if meta or (showLinks and (manifestUrl or miradorUrl or uvUrl)) %}
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 px-2 py-1 small text-muted border-top">

        <span>{{ meta }}</span>

        {% if showLinks %}
            <div class="d-flex gap-2">
            {% if resolvedInfoUrl %}
                <a href="{{ resolvedInfoUrl }}" target="_blank" class="btn btn-xs btn-ghost-secondary">IIIF ↗</a>
            {% endif %}
            {% if manifestUrl %}
                <a href="{{ manifestUrl }}" target="_blank" class="btn btn-xs btn-ghost-secondary">Manifest ↗</a>
            {% endif %}
            {% if miradorUrl %}
                <a href="{{ miradorUrl }}" target="_blank" class="btn btn-xs btn-ghost-secondary">Mirador ↗</a>
            {% endif %}
            {% if uvUrl %}
                <a href="{{ uvUrl }}" target="_blank" class="btn btn-xs btn-ghost-secondary">Universal Viewer ↗</a>
            {% endif %}
            </div>
        {% endif %}

    </div>
    {% endif %}

</div>
