{#
  IiifViewer component — OpenSeadragon IIIF viewer with optional external viewer links.

  Props (from IiifViewer.php):
    infoUrl         (string)  IIIF Image API info.json URL
    manifestUrl     (string)  Direct link to the raw IIIF manifest JSON
    options         (object)  OpenSeadragon viewer options
    miradorUrl      (string)  App route that redirects to Mirador
    uvUrl           (string)  App route that redirects to Universal Viewer
    meta            (string)  Optional footer metadata string
    height          (int)     Viewer max height in pixels
    showLinks       (bool)    Show external viewer link buttons
#}

{% set resolvedInfoUrl = infoUrl ?? '' %}
{% set viewerHeight = height|default(420) %}

{% set defaultStyle %}
    background:#111111;
    width:100%;
    position:relative;
    min-height:{{ viewerHeight }}px;
    height:clamp(320px,70vh,{{ viewerHeight }}px);
{% endset %}

{% set divaStyle %}
    background:#f7f5f1;
    width:100%;
    position:relative;
    min-height:{{ viewerHeight }}px;
    height:clamp(320px,70vh,{{ viewerHeight }}px);
{% endset %}

{% set viewerOptions = options|default({}) %}

<div {{ attributes.defaults({ class: 'iiif-viewer' }) }}>

    <style>
        .iiif-viewer {
            width: 100%;
            max-width: 100%;
        }

        .iiif-viewer .openseadragon-container {
            position: absolute !important;
            inset: 0;
            width: 100% !important;
            height: 100% !important;
        }

        @media (max-width: 768px) {
            .iiif-viewer [data-controller] {
                height: 60vh !important;
                min-height: 300px !important;
            }
        }
    </style>

    {% if viewer == 'diva' and manifestUrl %}

        {% set _sc = survos_stimulus('iiif-bundle', 'iiif-diva') %}

        <div
            {{
                stimulus_controller(_sc,
                    viewerOptions is not empty
                        ? { manifestUrl: manifestUrl, options: viewerOptions }
                        : { manifestUrl: manifestUrl }
                )
            }}
            style="{{ divaStyle }}">
        </div>

    {% elseif images|default([]) is not empty %}

        {% set _sc = survos_stimulus('iiif-bundle', 'iiif-viewer') %}
        {% set viewerValues = { images: images } %}

        {% if hiresImages|default([]) is not empty %}
            {% set viewerValues = viewerValues|merge({ hiresImages: hiresImages }) %}
        {% endif %}

        {% if viewerOptions is not empty %}
            {% set viewerValues = viewerValues|merge({ options: viewerOptions }) %}
        {% endif %}

        <div
            {{ stimulus_controller(_sc, viewerValues) }}
            style="{{ defaultStyle }}">
        </div>

    {% elseif resolvedInfoUrl %}

        {% set _sc = survos_stimulus('iiif-bundle', 'iiif-viewer') %}

        <div
            {{
                stimulus_controller(_sc,
                    viewerOptions is not empty
                        ? { manifestUrl: manifestUrl, tileSourceUrl: resolvedInfoUrl, options: viewerOptions }
                        : { manifestUrl: manifestUrl, tileSourceUrl: resolvedInfoUrl }
                )
            }}
            style="{{ defaultStyle }}">
        </div>

    {% else %}

        <div style="min-height:{{ viewerHeight }}px; display:flex; align-items:center;
                    justify-content:center; background:#111; color:#666; border-radius:4px;">
            <span style="font-size:.85rem;">No image available</span>
        </div>

    {% endif %}

    {% if meta or (showLinks and (manifestUrl or miradorUrl or uvUrl)) %}
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 px-2 py-1 small text-muted border-top">

            <span>{{ meta }}</span>

            {% if showLinks %}
                <div class="d-flex gap-2 flex-wrap">
                    {% if resolvedInfoUrl %}
                        <a href="{{ resolvedInfoUrl }}" target="_blank" class="btn btn-xs btn-ghost-secondary">IIIF ↗</a>
                    {% endif %}

                    {% if manifestUrl %}
                        <a href="{{ manifestUrl }}" target="_blank" class="btn btn-xs btn-ghost-secondary">Manifest ↗</a>
                    {% endif %}

                    {% if miradorUrl %}
                        <a href="{{ miradorUrl }}" target="_blank" class="btn btn-xs btn-ghost-secondary">Mirador ↗</a>
                    {% endif %}

                    {% if uvUrl %}
                        <a href="{{ uvUrl }}" target="_blank" class="btn btn-xs btn-ghost-secondary">Universal Viewer ↗</a>
                    {% endif %}
                </div>
            {% endif %}

        </div>
    {% endif %}

</div>
