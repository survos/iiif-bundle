{
  "name": "@survos/iiif-bundle",
  "description": "Document/page viewer Stimulus controllers (OpenSeadragon images, diva.js, pdf.js — all emit iiif-viewer:page)",
  "keywords": [
    "symfony-ux"
  ],
  "symfony": {
    "controllers": {
      "iiif-viewer": {
        "main": "controllers/iiif-viewer_controller.js",
        "enabled": true,
        "fetch": "lazy",
        "autoimport": []
      },
      "iiif-diva": {
        "main": "controllers/diva_viewer_controller.js",
        "enabled": true,
        "fetch": "lazy",
        "autoimport": []
      },
      "iiif-pdf": {
        "main": "controllers/pdf_viewer_controller.js",
        "enabled": true,
        "fetch": "lazy",
        "autoimport": []
      }
    },
    "importmap": {
      "openseadragon": "^6.0.1",
      "diva.js": "^7.2.6",
      "pdfjs-dist": "^6.0.0"
    }
  }
}
