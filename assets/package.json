{
  "name": "@survos/iiif",
  "description": "IIIF viewer Stimulus controllers (OpenSeadragon single-image, diva.js document)",
  "keywords": [
    "symfony-ux"
  ],
  "symfony": {
    "controllers": {
      "iiif-viewer": {
        "name": "survos/iiif/iiif-viewer",
        "main": "controllers/iiif-viewer_controller.js",
        "enabled": true,
        "fetch": "lazy",
        "autoimport": []
      },
      "iiif-diva": {
        "name": "survos/iiif/iiif-diva",
        "main": "controllers/diva_viewer_controller.js",
        "enabled": true,
        "fetch": "lazy",
        "autoimport": []
      }
    },
    "importmap": {
      "openseadragon": "^6.0.1",
      "diva.js": "^7.2.6"
    }
  }
}
